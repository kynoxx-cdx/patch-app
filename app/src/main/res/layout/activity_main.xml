<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050507"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="// PATCH APP //"
            android:textColor="#ff2d3c"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LICENSE KEY"
            android:textColor="#8a8a96"
            android:textSize="11sp"
            android:paddingBottom="8dp"/>

        <EditText
            android:id="@+id/etKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0a0a0e"
            android:padding="16dp"
            android:textColor="#00e5ff"
            android:textColorHint="#4a4a55"
            android:hint="XXXX-XXXX-XXXX-XXXX"
            android:inputType="textCapCharacters"
            android:gravity="center"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="CEK LICENSE"
            android:backgroundTint="#ff2d3c"
            android:textColor="#ffffff"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PILIH GAME"
            android:textColor="#8a8a96"
            android:textSize="11sp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgGame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbFFMax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Free Fire MAX"
                android:textColor="#f5f5f7"
                android:padding="12dp"/>

            <RadioButton
                android:id="@+id/rbFFTh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Free Fire Thailand (TH)"
                android:textColor="#f5f5f7"
                android:padding="12dp"/>
        </RadioGroup>

        <Button
            android:id="@+id/btnInject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="TEMPEL FILE"
            android:backgroundTint="#00ff9d"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text=""
            android:textColor="#8a8a96"
            android:textSize="12sp"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>
